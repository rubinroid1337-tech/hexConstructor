#include <raylib.h>
#include <raymath.h>

#include "gate.hpp"
#include "gate-system.hpp"

#include <iostream>

int main() {
    constexpr int screen_width  = 800;
    constexpr int screen_height = 450;
    InitWindow(screen_width, screen_height, "hex constructor");

    SetTargetFPS(60);

    while (!WindowShouldClose())
    {
        BeginDrawing();

        ClearBackground(RAYWHITE);

        EndDrawing();
    }

    CloseWindow();
}
